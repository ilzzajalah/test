# Server Port (default: 3000)
PORT=3000

# WhatsApp Group invite link (kept strictly on server, never sent to client until successful verification)
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/LnG7AinBC5pA4CFgthuLN0

# Required hashtags (comma-separated, without spaces)
REQUIRED_HASHTAGS=#zeverdnewera,#zeverdfamily

# Cloudflare Turnstile CAPTCHA keys (optional in local dev, recommended in production)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis configuration (optional; falls back to robust in-memory sliding rate limiter & anti-replay cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Allowed Origin for anti-CSRF check
ALLOWED_ORIGIN=http://localhost:3000

# IP hashing salt for privacy-compliant rate limiting
IP_HASH_SALT=zeverd_secret_salt_2026_super_secure
